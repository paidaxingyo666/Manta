# Standard ports, since the ICP filing cleared on 2026-08-30.
#
# Before that this host's provider hijacked 80 and 443 for the unfiled domain:
# the filter inspected cleartext HTTP by Host header on any port — 9443 included,
# which 302'd to a block page — while leaving TLS alone elsewhere. So the site
# listened on 9443, served TLS only, and pinned a certificate it could not renew,
# because ACME needs 80 or 443. All three workarounds are gone with the filing.

{$RELAY_DOMAIN} {
	# Managed again, so the 2026-11-17 expiry the pinned certificate carried no
	# longer applies. Watch for `certificate obtained successfully` on the first
	# deploy: Caddy serves the old certificate until renewal, so a failure here
	# stays silent until it matters.

	@metrics path /metrics
	respond @metrics 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The relay's own surface. Anything not listed falls through to the page
	# below, so a new relay route has to be added here too or it answers HTML.
	@relay path /health /healthz /session /authorize /v1/*
	handle @relay {
		# WebSocket upgrades pass through unchanged; the relay needs the original
		# Authorization header on the control leg. flush_interval -1 disables
		# response buffering, which would otherwise add latency to every frame.
		reverse_proxy relay:8787 {
			flush_interval -1
		}
	}

	# Why a page at all: the filing is for a website, so the domain has to serve
	# something over HTTP. It carries the filing number and nothing else — the
	# relay has no public surface worth documenting.
	handle {
		root * /srv/site
		file_server
	}

	# No query-string filtering needed: the enrolment secret moved into the POST
	# body of /session, so it never appears in a URL, a log, or browser history
	# in the first place.
	log {
		output stdout
		format json
	}
}
