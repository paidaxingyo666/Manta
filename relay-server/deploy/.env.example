# Copy to .env and fill in. Every value here is required: docker compose refuses
# to start without them rather than falling back to something insecure.

# The domain this relay answers on. Caddy gets its certificate for this name,
# and it is signed byte-for-byte into every host challenge — so it must match
# what the desktop has configured, exactly.
RELAY_DOMAIN=relay.example.com

# The public port. 443 is the normal answer. A non-standard port is for hosts
# where 443 is unusable — see "TLS on a non-standard port" in ../README.md;
# whatever you pick has to appear in the desktop's endpoint too.
RELAY_PORT=443

# What a desktop presents to enrol. Without it the enrolment endpoint is open to
# anyone who can reach the origin.
#   openssl rand -base64 32
MANTA_RELAY_ENROLLMENT_SECRET=

# Signs relay tokens. Leave it empty and the relay starts with a random one that
# changes on every restart — which, since rebuilding is how you deploy, means
# every deploy invalidates the tokens already issued.
#   openssl rand -base64 32
MANTA_RELAY_TOKEN_SECRET=

# Optional. A published image to pull instead of building from source — the
# build takes minutes on a small VPS and needs a toolchain the host may not
# have. Left unset, compose builds the checkout you are standing in, which is
# what an unreleased commit needs.
#
#   RELAY_IMAGE=paidaxingyo666/manta-relay:1.0.0
#
# From inside mainland China, the Aliyun mirror is the same image — one build
# pushes to both, so the digest matches:
#
#   RELAY_IMAGE=crpi-b5cuqx1nkkudw599.cn-shanghai.personal.cr.aliyuncs.com/manta-relay/manta-relay:1.0.0
#
# Pin a version rather than :latest, or a digest if you want the exact bytes.
RELAY_IMAGE=
