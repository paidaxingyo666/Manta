# Copy to .env and fill in. Every value here is required: docker compose refuses
# to start without them rather than falling back to something insecure.

# The domain this relay answers on. Caddy gets its certificate for this name,
# and it is signed byte-for-byte into every host challenge — so it must match
# what the desktop has configured, exactly.
RELAY_DOMAIN=relay.example.com

# The registered domain, which serves the filing's page. Its own name rather than
# a path on the relay: nothing to keep in sync, so a relay route added later can
# never fall through and answer HTML. Caddy also covers www. of this name.
SITE_DOMAIN=example.com


# What a desktop presents to enrol. Without it the enrolment endpoint is open to
# anyone who can reach the origin.
#   openssl rand -base64 32
MANTA_RELAY_ENROLLMENT_SECRET=

# Signs relay tokens. Leave it empty and the relay starts with a random one that
# changes on every restart — which, since rebuilding is how you deploy, means
# every deploy invalidates the tokens already issued.
#   openssl rand -base64 32
MANTA_RELAY_TOKEN_SECRET=

# Optional. A published image to pull instead of building from source — the
# build takes minutes on a small VPS and needs a toolchain the host may not
# have. Left unset, compose builds the checkout you are standing in, which is
# what an unreleased commit needs.
#
#   RELAY_IMAGE=paidaxingyo666/manta-relay:1.1.0-dev.1
#
# From inside mainland China, the Aliyun mirror is the same image — one build
# pushes to both, so the digest matches:
#
#   RELAY_IMAGE=crpi-b5cuqx1nkkudw599.cn-shanghai.personal.cr.aliyuncs.com/manta-relay/manta-relay:1.1.0-dev.1
#
# Accounts need 1.1.0 or newer. 1.0.0 predates them and answers 404 on every
# account endpoint, so sign-in and the machine list are absent against it.
#
# Pin a version rather than :latest, or a digest if you want the exact bytes.
RELAY_IMAGE=

# Does this relay serve one identity, or one per person?
#
#   (unset)   one identity for everyone holding the enrolment secret. Nothing
#             to sign in to, no machine list. This is the default and what
#             every relay was before accounts existed.
#   per-user  each person registers and gets their own identity and machines.
#             The enrolment secret then only gates who may register.
#
# A relay cannot be both: one careless click would otherwise put someone on the
# shared identity, where their machines are everyone's.
MANTA_RELAY_ACCOUNTS=

# Who may create an account. Only meaningful under per-user; a shared relay has
# no accounts to create.
#
#   (unset)    inherits the enrolment secret as its gate, which is what a relay
#              exposed to the internet wants
#   open       anyone who can reach the origin may register
#   disabled   rejected at startup under per-user — nobody could sign in at all
MANTA_RELAY_ALLOW_REGISTRATION=

# How many machines one account may claim. Bounds how much state a single
# account can make the relay keep.
MANTA_RELAY_MAX_HOSTS_PER_ACCOUNT=16

# Bearer token guarding /metrics; unset means the endpoint is not served at all.
# Worth setting: a push that succeeds logs nothing, so these counters are the
# only way to tell "no notifications were due" from "every one of them failed" —
# which is how a dead APNs connection went unnoticed for three days. Caddy 404s
# the path from outside, so it is reachable only on the host.
#   openssl rand -base64 32
MANTA_RELAY_METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Artifact hosting (optional, off)
# ---------------------------------------------------------------------------
# Turning this on changes what this deployment is. The relay is a byte pipe
# that stores credentials and forwards frames it cannot read; artifacts make it
# a content host that serves pages — written by whoever publishes them — to
# anyone holding the link. That is a decision about your disk, your bandwidth,
# and the rules you operate under, so it is never a default.
#
# What it gives you: the desktop's "share" produces a working public link
# against your own server instead of a host you do not run.
#
#   1 / true / yes / on   enable
#   anything else         off
MANTA_RELAY_ARTIFACTS=

# The origin published links point at. Required when the feature is on, and it
# MUST NOT be the relay's origin — the relay refuses to start if it is.
#
# Why a separate name and not a path: a published artifact runs with the
# privileges of whatever origin serves it. On the relay's origin, a page someone
# shared could call /v1/desktop/auth/* and the cell endpoints as the signed-in
# desktop. The separate origin IS the isolation; nothing else here replaces it.
#
# Point a second DNS record at this host, set ARTIFACTS_DOMAIN, and uncomment
# the artifact block in the Caddyfile.
MANTA_RELAY_ARTIFACTS_PUBLIC_URL=
ARTIFACTS_DOMAIN=

# Per-artifact ceiling. Matches the desktop's own limit; raising it past that
# only wastes the space, since the app refuses to send more.
MANTA_RELAY_ARTIFACTS_MAX_BYTES=10485760

# How long a published link lives. It has to outlast the conversation it was
# shared in, and you pay for the storage until it expires.
MANTA_RELAY_ARTIFACTS_TTL_MS=2592000000

# Per-account allowances. These are what stand between one enthusiastic user
# and a full disk — the relay cannot police what people publish, only how much.
MANTA_RELAY_ARTIFACTS_MAX_PER_ACCOUNT=100
MANTA_RELAY_ARTIFACTS_MAX_TOTAL_BYTES=268435456
