# Copy to .env next to docker-compose.yml and fill in. Restrict it first —
# it holds the token secret, and a default umask leaves it world-readable:
#
#   install -m 0600 .env.example .env && $EDITOR .env

# The public hostname phones and desktops dial. Must already resolve here.
RELAY_DOMAIN=relay.example.com

# Signs relay tokens. Generate once and keep it:
#   openssl rand -base64 32
# Rotating it invalidates outstanding relay tokens (1h TTL). The desktop
# re-mints one on its own within the hour; nobody signs out and no phone
# re-pairs. Auth sessions are hashed random UUIDs and are unaffected.
MANTA_RELAY_TOKEN_SECRET=

# Required unless the relay is only reachable on loopback. Without it,
# /authorize hands a session to anyone who can open the URL. You paste this once
# in the browser when connecting a desktop.
#   openssl rand -base64 24
MANTA_RELAY_ENROLLMENT_SECRET=

# Optional. Guards /metrics; leave empty to not serve it at all.
#   openssl rand -hex 32
MANTA_RELAY_METRICS_TOKEN=

# Identity reported to the desktop. Leave MANTA_RELAY_ORG_ID empty unless the
# desktop profile really has an organization: the value is compared byte for
# byte inside the host proof, and a mismatch fails pairing with no useful error.
MANTA_RELAY_USER_ID=self-hosted-user
MANTA_RELAY_PROFILE_ID=self-hosted-profile
MANTA_RELAY_ORG_ID=
MANTA_RELAY_USER_EMAIL=user@self-hosted.local
MANTA_RELAY_USER_NAME=Self-hosted user

# debug | info | warn | error
MANTA_RELAY_LOG_LEVEL=info
